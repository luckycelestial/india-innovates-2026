# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# whatsapp session / logs
whatsapp_session.db*
whatsapp_bot.log*
whatsapp_debug.log*
*.db
*.log

# python cache
__pycache__/
*.pyc
